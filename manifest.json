{
  "id": "jouzu",
  "icons": {
    "light": "logo.png",
    "dark": "logo.png"
  },
  "version": "0.1.8",
  "protocol": 0,
  "command": [
    "node",
    "jouzu-adapter.cjs"
  ],
  "runtime": {
    "package": "jouzu",
    "version": "0.1.13",
    "command": [
      "node",
      "runtime/dist/cli.js"
    ]
  },
  "extensions": [
    "agent-presets",
    "plan"
  ],
  "capabilities": [
    "models",
    "providers",
    "runtime",
    "presets",
    "plan",
    "review",
    "fork",
    "stats",
    "compact",
    "rename",
    "skills",
    "history-readonly"
  ],
  "pluginType": "harness-adapter",
  "name": "Jouzu",
  "summary": "pi-compatible harness driving the jouzu runtime.",
  "release": {
    "repository": "sabishii-me/agent-hub-harness-adapter-jouzu"
  }
}
